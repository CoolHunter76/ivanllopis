#!/usr/bin/env bash
set -Eeuo pipefail

ENVIRONMENT="${1:-}"
BRANCH="${2:-}"
APP_DIR="/opt/ivanllopis/app"
REPOSITORY="https://github.com/CoolHunter76/ivanllopis.git"

verify_health() {
    local url="$1"
    local expected_environment="$2"
    local expected_version="$3"
    local expected_commit="$4"
    local payload

    payload="$(curl --fail --silent --show-error --max-time 10 "$url")" || return 1

    HEALTH_PAYLOAD="$payload" \
    EXPECTED_ENVIRONMENT="$expected_environment" \
    EXPECTED_VERSION="$expected_version" \
    EXPECTED_COMMIT="$expected_commit" \
    python3 - <<'HEALTHCHECK'
import json
import os

payload = json.loads(os.environ["HEALTH_PAYLOAD"])
deployment = payload.get("deployment", {})
expected = {
    "environment": os.environ["EXPECTED_ENVIRONMENT"],
    "version": os.environ["EXPECTED_VERSION"],
    "commit": os.environ["EXPECTED_COMMIT"],
}

if payload.get("status") != "ok":
    raise SystemExit("Health status is not ok")
if deployment != expected:
    raise SystemExit(
        "Deployment identity mismatch: "
        + json.dumps({"expected": expected, "actual": deployment}, sort_keys=True)
    )
HEALTHCHECK
}

if [[ "$ENVIRONMENT" != "production" ]]; then
    echo "Unsupported environment: $ENVIRONMENT"
    exit 1
fi

if [[ "$BRANCH" != "master" ]]; then
    echo "Production can only deploy master."
    exit 1
fi

if [[ ! -d "$APP_DIR/.git" ]]; then
    mkdir -p "$(dirname "$APP_DIR")"
    git clone --branch "$BRANCH" "$REPOSITORY" "$APP_DIR"
fi

cd "$APP_DIR"

git fetch --prune origin "$BRANCH"
git checkout "$BRANCH"
git reset --hard "origin/$BRANCH"
export APP_ENV="production"
export APP_VERSION="3.0.0.0"
export APP_COMMIT="$(git rev-parse HEAD)"

docker compose build --pull
docker compose up -d --remove-orphans

for attempt in {1..10}; do
    if verify_health \
      "http://127.0.0.1:8000/health" \
      "$APP_ENV" \
      "$APP_VERSION" \
      "$APP_COMMIT"; then
        docker image prune -f
        echo "Production deployment completed successfully."
        exit 0
    fi
    sleep 3
done

docker compose logs --tail=150 web
exit 1
